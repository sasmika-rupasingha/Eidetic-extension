{
  "name": "eidetic-extension",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --dev",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "package": "tsc --noEmit && node scripts/build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "idb-keyval": "6.3.0",
    "jsqr": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "temml": "0.14.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "fflate": "0.8.3",
    "jsdom": "31.0.1",
    "oxlint": "1.94.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "web-ext": "10.8.0"
  }
}
